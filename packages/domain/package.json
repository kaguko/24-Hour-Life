{
  "name": "@24h/domain",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Luật chơi thuần (không React/UI/localStorage). Tiêm rng để tất định.",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "clean": "rm -rf dist"
  }
}
