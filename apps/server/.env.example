# Cổng lắng nghe (Fly.io/Railway tự đặt PORT; mặc định 2567)
PORT=2567
# Các origin của frontend được phép gọi HTTP matchmaking, ngăn cách bằng dấu phẩy.
# Để trống hoặc "*" = cho mọi origin (chỉ dùng khi dev).
# CORS_ORIGINS=https://24-hour-life.vercel.app,http://localhost:3000
# Giới hạn chống lạm dụng: số phòng tối đa (mặc định 200) và lượt tạo/vào phòng mỗi phút mỗi IP (mặc định 120)
# MAX_ROOMS=200
# JOINS_PER_MINUTE=120
